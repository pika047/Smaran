<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Asked at runtime on Android 13+, the first time a reminder is set. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets reminders fire on time. If the person turns it off, reminders may be a few minutes late. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Alarms are wiped on restart; this lets us set them again. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <!-- Only our own alarms and notification buttons reach these two. -->
        <receiver
            android:name=".ReminderAlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".ReminderActionReceiver"
            android:exported="false" />

        <!--
          Exported so the system can deliver these broadcasts. Every action listed is a
          protected broadcast that only Android itself can send, so other apps cannot trigger it.
        -->
        <receiver
            android:name=".RescheduleRemindersReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
